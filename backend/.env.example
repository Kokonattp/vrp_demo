# Optional OSRM-compatible routing API.
# Example public demo server:
# OSRM_BASE_URL=https://router.project-osrm.org
OSRM_BASE_URL=

# Routing provider:
# - osrm: road routing, no live traffic
# - google: road routing with traffic-aware duration for VRP matrices
ROUTING_PROVIDER=osrm

# Required when ROUTING_PROVIDER=google.
# Enable Google Maps Platform Routes API for this key.
GOOGLE_MAPS_API_KEY=

# Google Routes API routing preference:
# TRAFFIC_AWARE is balanced; TRAFFIC_AWARE_OPTIMAL is more accurate but slower and limited to smaller matrices.
GOOGLE_ROUTING_PREFERENCE=TRAFFIC_AWARE

# Comma-separated frontend origins allowed to call the API.
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Zeabur injects PORT automatically. This default is only for local/docker fallback.
PORT=8080
