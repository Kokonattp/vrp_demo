# Optional OSRM-compatible routing API.
# Example public demo server:
# OSRM_BASE_URL=https://router.project-osrm.org
OSRM_BASE_URL=

# Routing provider:
# - osrm: road routing, no live traffic
# - google: road routing with traffic-aware duration for VRP matrices
# - mapbox: road routing with Mapbox driving-traffic profile when configured
ROUTING_PROVIDER=osrm

# Required when ROUTING_PROVIDER=google.
# Enable Google Maps Platform Routes API for this key.
GOOGLE_MAPS_API_KEY=

# Google Routes API routing preference:
# TRAFFIC_AWARE is balanced; TRAFFIC_AWARE_OPTIMAL is more accurate but slower and limited to smaller matrices.
GOOGLE_ROUTING_PREFERENCE=TRAFFIC_AWARE

# Traffic departure buckets used to estimate time-dependent VRP.
# Fixed-time stops use the closest bucket; flexible stops use the best bucket for insertion.
GOOGLE_TRAFFIC_BUCKETS=08:00,09:00,10:00,13:00,15:00,17:00
GOOGLE_TRAFFIC_TIMEZONE_OFFSET=+07:00

# Required when ROUTING_PROVIDER=mapbox.
# Mapbox Matrix driving-traffic supports up to 10 coordinates per request.
# The backend batches larger matrices automatically; lowering MAPBOX_MATRIX_BATCH_SIZE can help test rate limits.
MAPBOX_ACCESS_TOKEN=
MAPBOX_PROFILE=mapbox/driving-traffic
MAPBOX_TRAFFIC_BUCKETS=08:00,09:00,10:00,13:00,15:00,17:00
MAPBOX_TRAFFIC_TIMEZONE_OFFSET=+07:00
MAPBOX_MATRIX_BATCH_SIZE=0

# Flexible stops within this road distance/time of fixed-time anchors are encouraged to stay near them.
ANCHOR_CLUSTER_MAX_KM=6
ANCHOR_CLUSTER_MAX_MINUTES=25

# Comma-separated frontend origins allowed to call the API.
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Zeabur injects PORT automatically. This default is only for local/docker fallback.
PORT=8080
