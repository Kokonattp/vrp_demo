# Server-only backend URL for private Hugging Face Spaces or any private backend.
HF_API_URL=https://your-private-space.hf.space
HF_TOKEN=hf_your_write_or_read_token

# Optional public backend fallback. Prefer HF_API_URL for private deployments.
NEXT_PUBLIC_API_URL=https://your-vrp-backend.example.com

# Optional: enables the map City traffic toggle using Mapbox Traffic v1 vector tiles.
NEXT_PUBLIC_MAPBOX_TOKEN=pk_your_mapbox_public_token
